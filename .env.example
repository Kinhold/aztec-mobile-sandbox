# Required for every production backend. Use at least 32 random characters.
JWT_SECRET=

# Exact comma-separated browser origins. Leave empty to disable cross-origin browser access.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Legacy template OAuth adapter (disabled by default).
AUTH_ENABLED=false
VITE_APP_ID=
OAUTH_SERVER_URL=
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/api/oauth/callback,kinhold-aztec-sandbox:///oauth/callback
OAUTH_FRONTEND_REDIRECT_URL=http://localhost:8081

# Legacy template storage proxy (disabled by default and authenticated when enabled).
STORAGE_PROXY_ENABLED=false
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional Expo probe for the experimental JSON-RPC adapter.
EXPO_PUBLIC_PXE_RPC_URL=
